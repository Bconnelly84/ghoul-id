{
  "expo": {
    "name": "Monster High Scanner",
    "slug": "monster-high-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.collector.monsterhighscanner",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Monster High Scanner to scan doll box codes.",
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}